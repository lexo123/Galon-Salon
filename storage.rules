rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Public read-only for public assets (salon photos, employee photos, portfolio)
    // Uploads are strictly backend-managed via Admin SDK
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
